# App
APP_ENV="development"          # development | production
APP_NAME="UMSRMS API"
PORT=8080
GIN_MODE="debug"              # debug | release | test
FRONTEND_URL="http://localhost:5173"

# Auth
JWT_SECRET=""                 # REQUIRED in production; use a long random string
JWT_EXPIRE_HOURS=24

# Database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="umsrms"
DB_SSLMODE="disable"          # disable | require | verify-ca | verify-full

# Migrations: apply embedded migrations automatically on startup
RUN_MIGRATIONS=true

# File uploads (evidence)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# CORS: comma-separated origins, or "*" to accept all domains
CORS_ALLOWED_ORIGINS="*"

# Rate limiting: per-client-IP token bucket (auth routes are capped at 5/min)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
